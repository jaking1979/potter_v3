{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "potter://contracts/v0/client_event",
  "title": "Client API event v0",
  "description": "Backend -> client event stream. Event names adapt AG-UI shapes (T37 B2 ledger: 'Adapt (event shapes)'); approval events are Potter's own because AG-UI interrupts are not yet stable. Clients render; they never mint approvals. Events are display/telemetry only: no event, including APPROVAL_RESOLVED, is evidence of approval; only an E1-signed ApprovalRecord is.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "run_id",
    "task_id",
    "seq",
    "ts",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "potter.client_event/v0"
    },
    "type": {
      "enum": [
        "RUN_STARTED",
        "RUN_FINISHED",
        "RUN_ERROR",
        "TEXT_MESSAGE_START",
        "TEXT_MESSAGE_CONTENT",
        "TEXT_MESSAGE_END",
        "TOOL_CALL_START",
        "TOOL_CALL_END",
        "STATE_SNAPSHOT",
        "STATE_DELTA",
        "APPROVAL_REQUESTED",
        "APPROVAL_RESOLVED"
      ]
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Strictly increasing per run_id; gaps mean the client must resync from STATE_SNAPSHOT."
    },
    "ts": {
      "$ref": "#/$defs/unix"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "APPROVAL_REQUESTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approval_request_id",
              "action_hash",
              "summary",
              "expires_at"
            ],
            "properties": {
              "approval_request_id": {
                "$ref": "#/$defs/id"
              },
              "action_hash": {
                "$ref": "#/$defs/hex64"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "Display text only; never authority."
              },
              "expires_at": {
                "$ref": "#/$defs/unix"
              },
              "screenshot_ref": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "APPROVAL_RESOLVED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approval_request_id",
              "decision"
            ],
            "properties": {
              "approval_request_id": {
                "$ref": "#/$defs/id"
              },
              "decision": {
                "enum": [
                  "approve",
                  "deny",
                  "expired",
                  "superseded"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unix": {
      "type": "integer",
      "minimum": 0
    }
  }
}
