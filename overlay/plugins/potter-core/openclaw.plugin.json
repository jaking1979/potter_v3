{
  "id": "potter-core",
  "name": "Potter Core",
  "description": "Potter v3: control with approvals and receipts; context governor and fast path; model broker and spend ledger; staged memory and responsibilities; once-only effects and the Notion outbox.",
  "version": "3.12.0",
  "contracts": {
    "tools": [
      "memory_stage",
      "memory_review",
      "memory_review_apply",
      "responsibility_track",
      "responsibility_due",
      "responsibility_done",
      "notion_outbox_list",
      "notion_outbox_settle"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "enforce",
          "shadow"
        ]
      },
      "stateDir": {
        "type": "string"
      },
      "agents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "ownerIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "standingGrants": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "approvalTimeoutMs": {
        "type": "number"
      },
      "jevEnvFile": {
        "type": "string"
      },
      "policyPath": {
        "type": "string"
      },
      "governor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "jev": {
            "type": "boolean"
          },
          "timeoutMs": {
            "type": "number"
          }
        }
      },
      "fastPath": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "merrick": {
            "type": "string"
          }
        }
      },
      "workspace": {
        "type": "string"
      },
      "broker": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "enforce",
              "shadow"
            ]
          },
          "escalationDailyCapUsd": {
            "type": "number"
          },
          "escalationDailyMax": {
            "type": "integer"
          }
        }
      },
      "timezone": {
        "type": "string"
      },
      "brain": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "budget": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 30000
          }
        }
      },
      "kg": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "dbPath": {
            "type": "string"
          },
          "budget": {
            "type": "integer",
            "minimum": 500,
            "maximum": 10000
          },
          "owner": {
            "type": "string"
          },
          "capture": {
            "type": "boolean"
          },
          "queuePath": {
            "type": "string"
          },
          "usagePath": {
            "type": "string"
          }
        }
      }
    }
  }
}
