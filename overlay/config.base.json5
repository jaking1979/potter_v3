// Potter v3 base overlay for OpenClaw. Applied with `openclaw config patch`.
// Placeholders written as at-at-NAME-at-at are filled by the installer from the setup form; no secrets live here.
{
  update: { channel: "stable", checkOnStart: true },
  telemetry: { enabled: false },
  agents: {
    defaults: { userTimezone: "@@TIMEZONE@@" },
    entries: { potter: { identity: { name: "Potter", emoji: "🧠", avatar: "avatar.svg" } } },
  },
  // Potter look: accent color, follows the device's light/dark setting.
  ui: { seamColor: "#1F5FD1", prefs: { themeMode: "system" } },
  // Potter has the full toolset, like v2's main session. Only access control stays: the Telegram allowlist below.
  // Behavior rules (ask-first Notion writes, EHR wall, no unreviewed sends) live in SOUL.md, as they did in v2.
  tools: {
    profile: "full",
    exec: { mode: "full" },
    // Potter can add connections and change its own settings from chat without a separate approval step.
    openclaw: { autoApproveChanges: true },
  },
  // The owner may use owner-only tools (inspecting and changing scheduled jobs, config). Without this, Potter refuses
  // the owner's own "look at that automation" with a policy block.
  commands: { ownerAllowFrom: ["@@OWNER_TELEGRAM_ID@@"] },
  channels: {
    telegram: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: ["@@OWNER_TELEGRAM_ID@@"],
      groupPolicy: "disabled",
      tokenFile: "@@SECRETS_DIR@@/telegram.token",
    },
  },
  cron: { enabled: true },
}
